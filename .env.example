# Copy to .env (loaded automatically). Nothing here is required for the demo:
# every data source and the agent fall back to offline sample data / a
# deterministic explanation if these are unset.

# OpenAQ v3 API key (https://openaq.org) - optional, falls back to sample_data.json
OPENAQ_API_KEY=

# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/) - optional
FIRMS_MAP_KEY=

# Amazon Bedrock - optional, falls back to a deterministic template explanation.
# Model names change; check the Bedrock console for what's currently available
# to your account rather than trusting this default blindly.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=ap-south-1

# Only used by the Lambda ingest handler when deployed
KAVACH_TABLE_NAME=
